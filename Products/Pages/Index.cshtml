@page
@model IndexModel
@{
    ViewData["Title"] = "SKF Bearing Query";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">
                        <i class="bi bi-search"></i> SKF Bearing Query Dashboard
                    </h2>
                </div>
                <div class="card-body">
                    <p class="text-muted">Ask natural language questions about SKF bearing products (e.g., "What is the width of 6205?" or "Show me the bore diameter of 6205 N")</p>
                    
                    <form id="queryForm" class="mb-4">
                        <div class="mb-3">
                            <label for="queryInput" class="form-label fw-bold">Your Question:</label>
                            <div class="input-group">
                                <input type="text" 
                                       class="form-control form-control-lg" 
                                       id="queryInput" 
                                       placeholder="What is the width of 6205?"
                                       required />
                                <button class="btn btn-primary btn-lg" type="submit" id="askButton">
                                    <i class="bi bi-send"></i> Ask
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Loading Spinner -->
                    <div id="loadingSpinner" class="text-center d-none">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Analyzing your query...</p>
                    </div>

                    <!-- Result Container -->
                    <div id="resultContainer" class="d-none">
                        <div class="alert" role="alert" id="resultAlert">
                            <h5 class="alert-heading"><i class="bi bi-check-circle"></i> Answer:</h5>
                            <p id="answerText" class="mb-0"></p>
                        </div>

                        <!-- Product Details -->
                        <div id="productDetails" class="card mt-3 d-none">
                            <div class="card-body">
                                <h6 class="card-title">Product Details:</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Product:</strong> <span id="productName"></span></p>
                                        <p><strong>Attribute:</strong> <span id="attributeName"></span></p>
                                        <p><strong>Value:</strong> <span id="valueName"></span></p>
                                    </div>
                                    <div class="col-md-6" id="imageContainer" class="d-none">
                                        <img id="productImage" src="" alt="Product Image" class="img-fluid rounded" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Example Queries -->
                    <div class="mt-4">
                        <h6 class="text-muted">Example queries:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm btn-outline-secondary example-query" data-query="What is the width of 6205?">Width of 6205</button>
                            <button class="btn btn-sm btn-outline-secondary example-query" data-query="Bore diameter of 6205 N">Bore diameter of 6205 N</button>
                            <button class="btn btn-sm btn-outline-secondary example-query" data-query="What is the limiting speed for 6205?">Limiting speed of 6205</button>
                            <button class="btn btn-sm btn-outline-secondary example-query" data-query="Show me the outside diameter of 6205">Outside diameter of 6205</button>
                            <button class="btn btn-sm btn-outline-primary example-query" data-query="Tolerance class">Tolerance class (all)</button>
                            <button class="btn btn-sm btn-outline-primary example-query" data-query="Width">Width (all)</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- API Documentation -->
            <div class="card mt-4 shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-code-slash"></i> API Documentation</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-3">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Interactive API Documentation:</strong> 
                        <a href="/swagger" target="_blank" class="alert-link">Open Swagger UI</a> 
                        to test the API interactively or download OpenAPI/Postman collections.
                    </div>

                    <p><strong>Endpoint:</strong> <code>GET /api/query/ask?q={your_query}</code></p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-light p-3 rounded"><code>curl "http://localhost:5000/api/query/ask?q=What%20is%20the%20width%20of%206205%3F"</code></pre>
                    <p><strong>Response:</strong></p>
                    <pre class="bg-light p-3 rounded"><code>{
  "answer": "The Width of the 6205 bearing is 15mm.",
  "isError": false,
  "product": "6205",
  "attribute": "Width",
  "value": "15mm"
}</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('queryForm');
        const input = document.getElementById('queryInput');
        const spinner = document.getElementById('loadingSpinner');
        const resultContainer = document.getElementById('resultContainer');
        const resultAlert = document.getElementById('resultAlert');
        const answerText = document.getElementById('answerText');
        const productDetails = document.getElementById('productDetails');
        const productName = document.getElementById('productName');
        const attributeName = document.getElementById('attributeName');
        const valueName = document.getElementById('valueName');
        const imageContainer = document.getElementById('imageContainer');
        const productImage = document.getElementById('productImage');

        // Handle form submission
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            await processQuery(input.value);
        });

        // Handle example queries
        document.querySelectorAll('.example-query').forEach(button => {
            button.addEventListener('click', function() {
                const query = this.getAttribute('data-query');
                input.value = query;
                processQuery(query);
            });
        });

        async function processQuery(query) {
            if (!query.trim()) return;

            // Show loading
            spinner.classList.remove('d-none');
            resultContainer.classList.add('d-none');
            productDetails.classList.add('d-none');
            imageContainer.classList.add('d-none');

            try {
                const response = await fetch(`/api/query/ask?q=${encodeURIComponent(query)}`);
                const data = await response.json();

                // Hide loading
                spinner.classList.add('d-none');
                resultContainer.classList.remove('d-none');

                // Display answer (preserve line breaks for multi-product responses)
                answerText.innerHTML = data.answer.replace(/\n/g, '<br>');
                
                if (data.isError) {
                    resultAlert.className = 'alert alert-warning';
                    resultAlert.querySelector('h5').innerHTML = '<i class="bi bi-exclamation-triangle"></i> Notice:';
                } else {
                    resultAlert.className = 'alert alert-success';
                    resultAlert.querySelector('h5').innerHTML = '<i class="bi bi-check-circle"></i> Answer:';
                    
                    // Show product details if available
                    if (data.product) {
                        productDetails.classList.remove('d-none');
                        productName.textContent = data.product;
                        attributeName.textContent = data.attribute || 'N/A';
                        valueName.textContent = data.value || 'N/A';

                        // Show image if available
                        if (data.imageUrl) {
                            imageContainer.classList.remove('d-none');
                            productImage.src = data.imageUrl;
                            productImage.alt = `${data.product} Image`;
                        }
                    }
                }
            } catch (error) {
                spinner.classList.add('d-none');
                resultContainer.classList.remove('d-none');
                resultAlert.className = 'alert alert-danger';
                resultAlert.querySelector('h5').innerHTML = '<i class="bi bi-x-circle"></i> Error:';
                answerText.textContent = 'Failed to process query. Please try again.';
                console.error('Query error:', error);
            }
        }
    });
</script>
}
